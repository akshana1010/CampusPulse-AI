# ─────────────────────────────────────────────────────────────────────────────
# CampusPulse AI – Environment Variables Template
# Copy this file to `.env` and fill in your values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development
# FLASK_ENV options: development | testing | production

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use default SQLite path (instance/campuspulse.db)
DATABASE_URL=

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# ── File Uploads ──────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=5242880
# 5242880 bytes = 5 MB

# ── Campus Map ────────────────────────────────────────────────────────────────
CAMPUS_NAME=My University
CAMPUS_LAT=28.6139
CAMPUS_LNG=77.2090
CAMPUS_ZOOM=16

# ── Administrator Credentials (Optional) ─────────────────────────────────────
# Automatic admin initialization for Render / cloud deployments
ADMIN_ID=admin
ADMIN_EMAIL=admin@campuspulse.ai
ADMIN_PASSWORD=change-this-in-production
